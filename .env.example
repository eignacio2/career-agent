# Everything here is optional. With no configuration at all the agent still runs
# end to end: it uses built-in keyword heuristics for matching and writes mail to
# .data/outbox instead of sending it.

# ---------------------------------------------------------------------------
# Language model — turns keyword matching into real reasoning
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, Groq, Together, OpenRouter,
# Ollama, or a local vLLM server.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Outbound email — daily digests and email-based applications
# ---------------------------------------------------------------------------
# Gmail requires an App Password, not your account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=you@gmail.com

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# When set, /api/cron/daily requires this value as a bearer token or ?token=.
# CRON_SECRET=

# Absolute URL used for links inside digest emails.
# APP_BASE_URL=http://127.0.0.1:43317

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Defaults to .data/career-agent.db
# CAREER_AGENT_DB=
