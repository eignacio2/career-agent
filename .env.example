# Everything here is optional. With no configuration the agent still runs:
# it scores with built-in heuristics and uses the bundled sample board if
# live job boards are unreachable.

# Force the bundled sample board (no network). Useful for tests and demos.
# CAREER_AGENT_OFFLINE=1

# SQLite path. Defaults to .data/career-agent.db
# CAREER_AGENT_DB=

# When set, POST /runs and POST /api/cron/daily require this bearer token.
# CRON_SECRET=

# Public URL of this app, used in logs. Does not have to match the bind port.
# APP_BASE_URL=http://127.0.0.1:43421
