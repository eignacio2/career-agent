# Everything here is optional. The CLI runs with zero config.

# CAREER_AGENT_OFFLINE=1
# CAREER_AGENT_DB=
# APP_BASE_URL=http://127.0.0.1:43421

# Outbound mail for digests and email applications.
# Without these, messages are written to .data/outbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=you@gmail.com

# CRON_SECRET=
